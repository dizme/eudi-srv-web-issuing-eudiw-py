[ ca ]
default_ca = CA_default

[ CA_default ]
# OpenSSL CA bookkeeping
database          = ./index.txt
new_certs_dir     = ./newcerts
serial            = ./serial

# These are overridden on the command line but must exist
private_key       = ca.key.pem
certificate       = ca.cert.pem

default_md        = sha256
default_days      = 3650
policy            = policy_loose
copy_extensions   = none

############################################
# DN policy (loose, but CN required)
############################################

[ policy_loose ]
countryName             = optional
stateOrProvinceName     = optional
localityName            = optional
organizationName        = optional
organizationalUnitName  = optional
commonName              = supplied
emailAddress            = optional

############################################
# CA certificate profile
############################################

[ v3_ca ]
basicConstraints = critical, CA:TRUE, pathlen:0
keyUsage = critical, keyCertSign, cRLSign
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always

############################################
# End-entity signing certificate profile
# (adapted from signing.cnf)
############################################

[ v3_sign_ee ]
basicConstraints = critical, CA:FALSE
keyUsage = critical, digitalSignature
extendedKeyUsage = critical, 1.3.130.2.0.0.1.2
subjectKeyIdentifier = hash
authorityKeyIdentifier = keyid:always